# Swift Package Manager
.swiftpm/
Packages/
Package.resolved

# CocoaPods
Pods/

# Carthage
Carthage/Build/

# Fastlane output, if added later
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# Apple code-signing material
*.mobileprovision
*.provisionprofile
*.p12
*.cer

# Environment variables, local configuration, and secrets
.env
.env.*
*.pem
*.key

# Local exports and scratch files
*.tmp
*.log